{
  "name": "vscode-cpu-status",
  "displayName": "CPU Status",
  "description": "Shows CPU core usage as bars in the status bar",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "icon": "icon.png",
  "publisher": "xmarano",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "typescript": "^5.1.6",
    "@types/node": "^20.5.6",
    "@types/vscode": "^1.90.0"
  }
}
